{
  "manifest_version": 3,
  "name": "SubFreeze Netflix Dual Subtitles",
  "version": "2.0.0",
  "description": "Show two Netflix subtitle languages at the same time. Just pick two languages.",
  "host_permissions": ["https://www.netflix.com/*"],
  "action": {
    "default_title": "Toggle Dual Subtitles"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "subfreeze-netflix@local",
      "strict_min_version": "128.0"
    }
  }
}
