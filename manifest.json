{
  "manifest_version": 3,
  "name": "SubFreeze Netflix Dual Subtitles",
  "version": "2.0.0",
  "description": "Show two Netflix subtitle languages at the same time. Just pick two languages.",
  "host_permissions": ["https://www.netflix.com/*"],
  "action": {
    "default_title": "Toggle Dual Subtitles"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "scripts": ["src/background/service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": [
        "src/content/core.js",
        "src/content/parser.js",
        "src/content/subtitles.js",
        "src/content/navigation.js",
        "src/content/overlay.js",
        "src/content/panel.js",
        "src/content/netflix-menu.js",
        "src/content/main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["src/content/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "css": ["src/styles/overlay.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "subfreeze-netflix@local",
      "strict_min_version": "128.0"
    }
  }
}
